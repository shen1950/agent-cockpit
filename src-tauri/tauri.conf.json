{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent 驾驶舱",
  "version": "2.1.7",
  "identifier": "com.renlu.agent-cockpit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent 驾驶舱",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
