{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent 驾驶舱",
  "version": "2.5.1",
  "identifier": "io.agentcockpit.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent 驾驶舱",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/third-party/": "licenses/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
