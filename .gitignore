# 构建产物与缓存（都可由源码重新生成，不入库）
src-tauri/target/
node_modules/
__pycache__/
*.pyc
*.spec
build/
dist/
bin/
installer/

# 日志
*.log

# 调试草稿（本地留着，不入库）
_dbg*.js
_paste_parser.js

# 改动前的回滚副本（留在磁盘上备查，不进历史）
*.bak-*
*.pre-migration

# 内部工作交接日志（本地留存，不开源）
HANDOFF.md

# 内部留存文档（法律底稿、文档维护手册等）。不进公开源码包：
# export_public_source.py 走 git ls-files，被忽略的路径不会被收录。
docs/private/

# 调试草稿
_noserve.py

# 界面预览图（本地留存，发布时作为 Release 附件）
docs/*.png
.agent-sync/

# 一次性改库备份
*.proxyfix-bak

# 界面截图草稿（本地核对用，不入库）
_real_*.png
_zoom_*.png

# Local rollback copies, personal configuration and release audits are never source.
*.bak
*.pdb
.env
.env.*
!.env.example
privacy-local/
release-private/
